# ── Netlify DB (Neon Postgres) ───────────────────────────────────────────
# Injected automatically by Netlify once the database is enabled on the site.
# Set it locally (Netlify → Extensions → Neon, or `netlify env:get`) to run
# `npm run db:setup` or `npm run dev` against the real database.
NETLIFY_DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# ── Team sign-in ─────────────────────────────────────────────────────────
# One shared password for everyone. SESSION_SECRET signs the login cookie;
# if unset the password is used. Generate with: openssl rand -hex 32
SHARED_PASSWORD=change-me
SESSION_SECRET=

# ── AI — transcript analysis, step breakdown, plan import, TaxDome ───────
# Set one or more keys. Default: zai when ZAI_API_KEY is set, then nvidia,
# then anthropic; AI_PROVIDER picks explicitly.
ZAI_API_KEY=
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=your-anthropic-api-key
# AI_PROVIDER=zai|nvidia|anthropic
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4    (default)
# ZAI_MODEL=glm-5.3                     (default)
# ZAI_MAX_TOKENS=16000                  (cap on Z.ai reply length, default)
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b   (default)
# NVIDIA_MAX_TOKENS=8192               (cap on NVIDIA reply length)
#
# "Break down with AI" runs inside a normal page request, which Netlify stops
# at 60s, so it gives up after 45s and uses its own, faster model (ZAI_MODEL /
# NVIDIA_MODEL do not apply to it). Leave empty for the defaults:
# glm-5.3-flash on Z.ai, nvidia/nemotron-3-super-120b-a12b on NVIDIA,
# the app's Claude model on Anthropic.
# ZAI_BREAKDOWN_MODEL=glm-5.3-flash     (default)
NVIDIA_BREAKDOWN_MODEL=
ANTHROPIC_BREAKDOWN_MODEL=

# ── TaxDome → Zapier → Flammard webhook ──────────────────────────────────
# Any long random string; Zapier sends it as "Authorization: Bearer <secret>".
TAXDOME_WEBHOOK_SECRET=change-me

# ── App ──────────────────────────────────────────────────────────────────
PUBLIC_APP_URL=http://localhost:4321
PUBLIC_APP_NAME=Flammard
# Shown in the header and on approved minutes as the approver
PUBLIC_TEAM_LABEL=Leadership team

# The firm's time zone — periods and "today" are worked out in local dates
PUBLIC_TIMEZONE=America/Chicago
