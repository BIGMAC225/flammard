# Supabase
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared team login (must match the user created in Supabase Auth)
SHARED_LOGIN_EMAIL=team@flammard.app

# Anthropic — transcript analysis and TaxDome report extraction
ANTHROPIC_API_KEY=your-anthropic-api-key

# TaxDome → Zapier → Flammard webhook. Any long random string; Zapier sends it
# as "Authorization: Bearer <secret>". Generate with: openssl rand -hex 32
TAXDOME_WEBHOOK_SECRET=change-me

# App
PUBLIC_APP_URL=http://localhost:4321
PUBLIC_APP_NAME=Flammard
