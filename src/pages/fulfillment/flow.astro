---
import Dashboard from '../../layouts/Dashboard.astro';
import { sql } from '../../lib/db';
import { todayLocal } from '../../lib/dates';
import {
  cumulativeFlow,
  loadCumulativeFlow,
  loadWeeklyEvents,
  weeklyFlow,
} from '../../lib/fulfillment-views';
import type { CfdRow, EventLite, WeekRow } from '../../lib/fulfillment-views';

const today = todayLocal();
// weeklyFlow buckets the 13 Monday-starting weeks ending this week, so fetch
// every event from 91 days back and let it drop what falls outside the window.
const since13w = new Date(Date.parse(`${today}T00:00:00Z`) - 91 * 86_400_000).toISOString().slice(0, 10);
const since90d = new Date(Date.parse(`${today}T00:00:00Z`) - 90 * 86_400_000).toISOString().slice(0, 10);

let flow: WeekRow[] = [];
let cfdRows: CfdRow[] = [];
let loadError: string | null = null;
try {
  const db = sql();
  flow = weeklyFlow(await loadWeeklyEvents(db, since13w), today, 13);
  cfdRows = await loadCumulativeFlow(db, since90d);
} catch (err) {
  loadError = err instanceof Error ? err.message : String(err);
  flow = [];
  cfdRows = [];
}

const cfd = cumulativeFlow(cfdRows);
const flowEmpty = flow.every((w) => w.arrivals === 0 && w.completions === 0);
const bothEmpty = flowEmpty && cfd.dates.length === 0;

// Weekly bars: one slot per week, arrivals left, completions right.
const flowMax = Math.max(1, ...flow.map((w) => Math.max(w.arrivals, w.completions)));
const chartW = 640;
const chartH = 200;
const padL = 34;
const padR = 10;
const padT = 14;
const padB = 36;
const plotW = chartW - padL - padR;
const plotH = chartH - padT - padB;
const slotW = flow.length ? plotW / flow.length : 0;
const barW = Math.min(16, slotW / 3);
const yBar = (v: number) => padT + plotH - (v / flowMax) * plotH;
const xBar = (i: number, second: boolean) => padL + i * slotW + slotW / 2 + (second ? 1 : -barW - 1);
const flowGrid = [...new Set([0, Math.round(flowMax / 2), flowMax])];

// Cumulative flow bands: one stacked area per stage in stage order. A fixed
// palette of 10 muted colours, cycled past the tenth stage.
const STAGE_COLORS = [
  '#8f9aa8', '#a3b18a', '#c9b1a5', '#b3a48c', '#8fa8a2',
  '#a8a28c', '#b8ad8e', '#9aa7bd', '#ad9aa6', '#7f94ad',
];
const stageColor = (i: number) => STAGE_COLORS[i % STAGE_COLORS.length];

const nDates = cfd.dates.length;
const totals = cfd.dates.map((_, i) => cfd.stages.reduce((n, s) => n + cfd.series[s][i], 0));
const cfdMax = Math.max(1, ...totals);
const cfdW = 640;
const cfdH = 220;
const cfdL = 34;
const cfdR = 10;
const cfdT = 14;
const cfdB = 40;
const cfdPlotW = cfdW - cfdL - cfdR;
const cfdPlotH = cfdH - cfdT - cfdB;
const xDate = (i: number) => (nDates > 1 ? cfdL + (cfdPlotW * i) / (nDates - 1) : cfdL + cfdPlotW / 2);
const yJobs = (v: number) => cfdT + cfdPlotH * (1 - v / cfdMax);
// cum[s][i]: the stacked height above stage s at date i.
const cum: number[][] = [];
let under = cfd.dates.map(() => 0);
for (const stage of cfd.stages) {
  const top = cfd.dates.map((_, i) => under[i] + cfd.series[stage][i]);
  cum.push(top);
  under = top;
}
// Stage s's band runs along its own top edge and the stage below's top edge.
function band(s: number): string {
  const pts: string[] = [];
  for (let i = 0; i < nDates; i++) pts.push(`${xDate(i).toFixed(1)},${yJobs(cum[s][i]).toFixed(1)}`);
  for (let i = nDates - 1; i >= 0; i--) pts.push(`${xDate(i).toFixed(1)},${yJobs(s > 0 ? cum[s - 1][i] : 0).toFixed(1)}`);
  return `M${pts.join(' L')} Z`;
}
const cfdGrid = [...new Set([0, Math.round(cfdMax / 2), cfdMax])];
const labelEvery = Math.max(1, Math.ceil(nDates / 8));
---

<Dashboard
  eyebrow="Fulfillment"
  title="Flow"
  description="Are we finishing what we start, and is one stage's band widening?"
  back={{ href: '/fulfillment', label: 'Fulfillment' }}
>
  {loadError && (
    <div class="card bg-amber-50 border-amber-200 mb-8">
      <p class="font-semibold text-amber-900">Fulfillment tables are not available yet</p>
      <p class="text-sm text-amber-900 mt-1">{loadError}</p>
    </div>
  )}

  {!loadError && bothEmpty && (
    <div class="card text-center py-12">
      <p class="text-lg font-medium text-ink-primary mb-2">No snapshots yet</p>
      <p class="text-sm text-ink-secondary mb-1">No job events or snapshots have been imported yet, so there is no flow to show.</p>
      <p class="text-sm text-ink-muted">Run the fulfillment poller to bring jobs in: docs/AUTOMATION.md, section 4.</p>
    </div>
  )}

  {!loadError && !bothEmpty && (
    <div class="mb-10">
      <h2 class="section-title mb-4">Arrivals vs completions</h2>
      <div class="card mb-4">
        <div class="flex items-center gap-4 mb-4 text-xs font-semibold text-ink-secondary">
          <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm bg-accent"></span> Arrivals</span>
          <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm bg-mint-500"></span> Completions</span>
        </div>
        <svg
          viewBox={`0 0 ${chartW} ${chartH}`}
          class="w-full"
          role="img"
          aria-label="Weekly arrivals and completions over the last 13 weeks"
        >
          {flowGrid.map((v) => (
            <g>
              <line x1={padL} y1={yBar(v)} x2={chartW - padR} y2={yBar(v)} class="stroke-line" stroke-width="1" />
              <text x={padL - 6} y={yBar(v) + 3} text-anchor="end" font-size="10" class="fill-ink-muted">{v}</text>
            </g>
          ))}
          {flow.map((w, i) => (
            <g>
              <rect
                x={xBar(i, false)}
                y={yBar(w.arrivals)}
                width={barW}
                height={padT + plotH - yBar(w.arrivals)}
                rx="2"
                class="fill-accent"
              />
              <rect
                x={xBar(i, true)}
                y={yBar(w.completions)}
                width={barW}
                height={padT + plotH - yBar(w.completions)}
                rx="2"
                class="fill-mint-500"
              />
              {i % 2 === 0 && (
                <text x={padL + i * slotW + slotW / 2} y={chartH - 12} text-anchor="middle" font-size="9" class="fill-ink-muted">
                  {w.week_start.slice(5)}
                </text>
              )}
            </g>
          ))}
        </svg>
      </div>
      <div class="card p-0 overflow-x-auto">
        <table class="table-brand">
          <thead>
            <tr>
              <th>Week of</th>
              <th>Arrivals</th>
              <th>Completions</th>
              <th>Net</th>
            </tr>
          </thead>
          <tbody>
            {flow.map((w) => (
              <tr>
                <td class="text-ink-secondary">{w.week_start}</td>
                <td class="text-ink-secondary tabular-nums">{w.arrivals}</td>
                <td class="text-ink-secondary tabular-nums">{w.completions}</td>
                <td class={`tabular-nums ${w.arrivals - w.completions > 0 ? 'text-amber-900 font-medium' : 'text-ink-secondary'}`}>
                  {w.arrivals - w.completions}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )}

  {!loadError && !bothEmpty && (
    <div>
      <h2 class="section-title mb-4">Cumulative flow</h2>
      {nDates < 2 && (
        <div class="card text-center py-8 mb-4">
          <p class="text-sm text-ink-secondary">The cumulative flow chart fills in as daily snapshots accumulate; fewer than two daily snapshots exist in the last 90 days so far.</p>
        </div>
      )}
      {nDates >= 2 && (
        <div class="card mb-4">
          <div class="flex flex-wrap items-center gap-4 mb-4 text-xs font-semibold text-ink-secondary">
            {cfd.stages.map((stage, s) => (
              <span class="inline-flex items-center gap-1.5"><span class="w-3 h-3 rounded-sm" style={`background: ${stageColor(s)}`}></span> {stage}</span>
            ))}
          </div>
          <svg
            viewBox={`0 0 ${cfdW} ${cfdH}`}
            class="w-full"
            role="img"
            aria-label="Jobs per stage per day over the last 90 days, stacked"
          >
            {cfdGrid.map((v) => (
              <g>
                <line x1={cfdL} y1={yJobs(v)} x2={cfdW - cfdR} y2={yJobs(v)} class="stroke-line" stroke-width="1" />
                <text x={cfdL - 6} y={yJobs(v) + 3} text-anchor="end" font-size="10" class="fill-ink-muted">{v}</text>
              </g>
            ))}
            {cfd.stages.map((stage, s) => (
              <path d={band(s)} fill={stageColor(s)}></path>
            ))}
            {cfd.dates.map((d, i) => (
              <g>
                {(i % labelEvery === 0 || i === nDates - 1) && (
                  <text x={xDate(i)} y={cfdH - 14} text-anchor="middle" font-size="9" class="fill-ink-muted">{d.slice(5)}</text>
                )}
              </g>
            ))}
          </svg>
        </div>
      )}
      {nDates >= 1 && (
        <div class="card p-0 overflow-x-auto">
          <table class="table-brand">
            <thead>
              <tr>
                <th>Date</th>
                {cfd.stages.map((stage) => (
                  <th>{stage}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {cfd.dates.map((d, i) => (
                <tr>
                  <td class="text-ink-secondary">{d}</td>
                  {cfd.stages.map((stage) => (
                    <td class="text-ink-secondary tabular-nums">{cfd.series[stage][i]}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  )}
</Dashboard>
