---
import Base from '../layouts/Base.astro';

const appName = import.meta.env.PUBLIC_APP_NAME || 'Flammard';
---

<Base
  title="Meeting records your organization can stand behind"
  description="Record meetings, draft structured minutes with AI, approve with a cryptographic seal, and track acknowledgement."
>
  <!-- ── NAV ──────────────────────────────────────────── -->
  <nav class="fixed top-0 inset-x-0 z-50 border-b border-white/5 bg-bg-base/80 backdrop-blur-md">
    <div class="max-w-6xl mx-auto px-5 h-14 flex items-center justify-between">
      <a href="/" class="font-semibold text-ink-primary tracking-tight">{appName}</a>
      <div class="hidden md:flex items-center gap-1 text-sm">
        <a href="#why" class="px-3 py-1.5 text-ink-secondary hover:text-ink-primary transition-colors rounded-lg hover:bg-white/5">Why {appName}</a>
        <a href="#how" class="px-3 py-1.5 text-ink-secondary hover:text-ink-primary transition-colors rounded-lg hover:bg-white/5">How it works</a>
        <a href="#faq" class="px-3 py-1.5 text-ink-secondary hover:text-ink-primary transition-colors rounded-lg hover:bg-white/5">FAQ</a>
      </div>
      <div class="flex items-center gap-2">
        <a href="/login" class="text-sm text-ink-secondary hover:text-ink-primary transition-colors px-3 py-1.5">Login</a>
        <a href="/signup" class="text-sm bg-accent hover:bg-accent-dim text-white px-4 py-1.5 rounded-lg font-medium transition-colors">
          Get started
        </a>
      </div>
    </div>
  </nav>

  <!-- ── HERO ─────────────────────────────────────────── -->
  <section class="relative pt-32 pb-24 px-5 overflow-hidden">
    <!-- Background glow -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute top-0 right-1/4 w-[600px] h-[400px] bg-accent/10 blur-[120px] rounded-full"></div>
      <div class="absolute bottom-0 left-1/4 w-[400px] h-[300px] bg-accent/5 blur-[100px] rounded-full"></div>
    </div>
    <!-- Grid pattern -->
    <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:48px_48px] pointer-events-none"></div>

    <div class="relative max-w-4xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 border border-line bg-bg-surface px-4 py-1.5 rounded-full text-xs text-ink-secondary mb-8">
        <span class="w-1.5 h-1.5 rounded-full bg-state-success animate-pulse"></span>
        Now in beta — full feature access, free
      </div>

      <h1 class="text-5xl sm:text-6xl lg:text-7xl font-semibold tracking-tight text-ink-primary leading-[1.08] mb-6">
        Meeting records<br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent to-purple-400">
          worth keeping.
        </span>
      </h1>

      <p class="text-lg sm:text-xl text-ink-secondary max-w-2xl mx-auto leading-relaxed mb-10">
        Record or upload your meeting. Let AI draft the minutes. Approve with a cryptographic seal.
        Distribute with tracked acknowledgement.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-16">
        <a href="/signup" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-accent hover:bg-accent-dim text-white font-medium px-7 py-3 rounded-xl text-base transition-all hover:shadow-lg hover:shadow-accent/20">
          Start for free
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="#how" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 border border-line hover:border-line-strong text-ink-secondary hover:text-ink-primary px-7 py-3 rounded-xl text-base transition-colors">
          See how it works
        </a>
      </div>

      <!-- Trust pills -->
      <div class="flex flex-wrap justify-center gap-3">
        {[
          { icon: '🔐', text: 'SHA-256 cryptographic seal' },
          { icon: '📨', text: 'No account for recipients' },
          { icon: '📋', text: 'Cross-meeting decision register' },
        ].map(({ icon, text }) => (
          <div class="inline-flex items-center gap-2 border border-line bg-bg-surface/60 px-4 py-2 rounded-full text-sm text-ink-secondary">
            <span>{icon}</span>
            {text}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── WHY ──────────────────────────────────────────── -->
  <section id="why" class="py-24 px-5 border-t border-line">
    <div class="max-w-5xl mx-auto">
      <div class="max-w-2xl mb-16">
        <p class="text-xs font-semibold tracking-widest text-accent uppercase mb-4">The problem</p>
        <h2 class="text-3xl sm:text-4xl font-semibold text-ink-primary leading-tight mb-5">
          Most meeting tools produce summaries.<br/>{appName} produces records.
        </h2>
        <p class="text-ink-secondary text-lg leading-relaxed">
          Your meetings produce decisions that shape your organization. The tools built to capture them were designed for convenience, not accountability.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-4">
        <!-- Old way -->
        <div class="bg-bg-surface border border-line rounded-2xl p-6">
          <div class="flex items-center gap-2 mb-5">
            <div class="w-5 h-5 rounded-full bg-state-danger/15 flex items-center justify-center">
              <span class="text-state-danger text-xs">✕</span>
            </div>
            <span class="text-sm font-medium text-ink-secondary">How teams typically work</span>
          </div>
          <ul class="space-y-3">
            {[
              'Notes live in shared docs with no approval workflow or version history',
              'Action items get extracted but never formally tracked across meetings',
              'No way to prove what was decided, when, or who acknowledged it',
              'Enterprise governance tools are overbuilt for teams under 50',
            ].map((item) => (
              <li class="flex items-start gap-3 text-sm text-ink-secondary">
                <span class="mt-1 w-1.5 h-1.5 rounded-full bg-state-danger/60 flex-shrink-0"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <!-- New way -->
        <div class="bg-bg-surface border border-accent/20 rounded-2xl p-6 relative overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-br from-accent/5 to-transparent pointer-events-none"></div>
          <div class="relative">
            <div class="flex items-center gap-2 mb-5">
              <div class="w-5 h-5 rounded-full bg-accent/20 flex items-center justify-center">
                <span class="text-accent text-xs">✓</span>
              </div>
              <span class="text-sm font-medium text-ink-secondary">How {appName} works</span>
            </div>
            <ul class="space-y-3">
              {[
                'Formal approval locks the record and seals it with a cryptographic hash',
                'Decisions and actions tracked across all meetings with ownership and status',
                'One-click distribution with tamper-evident acknowledgement tracking',
                'Right-sized for teams where meetings carry weight — no bloat',
              ].map((item) => (
                <li class="flex items-start gap-3 text-sm text-ink-secondary">
                  <span class="mt-1 w-1.5 h-1.5 rounded-full bg-state-success flex-shrink-0"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── HOW IT WORKS ──────────────────────────────────── -->
  <section id="how" class="py-24 px-5 border-t border-line">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-16">
        <p class="text-xs font-semibold tracking-widest text-accent uppercase mb-4">The process</p>
        <h2 class="text-3xl sm:text-4xl font-semibold text-ink-primary">
          From conversation to trusted record in four steps
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-px bg-line rounded-2xl overflow-hidden">
        {[
          {
            num: '01',
            title: 'Capture',
            desc: 'Record in-browser, upload an audio file, or paste your transcript directly. Sensitive discussion? Mark it off the record.',
            icon: `<path d="M12 2a3 3 0 0 1 3 3v6a3 3 0 0 1-6 0V5a3 3 0 0 1 3-3z" stroke="currentColor" stroke-width="1.5"/><path d="M19 11a7 7 0 0 1-14 0M12 22v-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>`,
          },
          {
            num: '02',
            title: 'Draft',
            desc: 'AI transcribes and extracts decisions, action items, and discussion points into a structured draft for your review.',
            icon: `<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke="currentColor" stroke-width="1.5"/><path d="M14 2v6h6M8 13h8M8 17h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>`,
          },
          {
            num: '03',
            title: 'Seal',
            desc: 'Edit and confirm the draft, then approve. Approval locks the record and seals it with a SHA-256 hash.',
            icon: `<rect x="3" y="11" width="18" height="11" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M7 11V7a5 5 0 0 1 10 0v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>`,
          },
          {
            num: '04',
            title: 'Verify',
            desc: 'Distribute to attendees. Each recipient gets a secure link to review the sealed minutes and confirm receipt — no account required.',
            icon: `<path d="M22 12h-4l-3 9L9 3l-3 9H2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>`,
          },
        ].map(({ num, title, desc, icon }) => (
          <div class="bg-bg-surface p-8 flex flex-col gap-5">
            <div class="flex items-start justify-between">
              <div class="w-11 h-11 rounded-xl bg-accent-muted flex items-center justify-center">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" set:html={icon} />
              </div>
              <span class="font-mono text-2xl font-bold text-ink-muted/50 leading-none">{num}</span>
            </div>
            <div>
              <h3 class="text-base font-semibold text-ink-primary mb-2">{title}</h3>
              <p class="text-sm text-ink-secondary leading-relaxed">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── FEATURES ──────────────────────────────────────── -->
  <section class="py-24 px-5 border-t border-line">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-16">
        <p class="text-xs font-semibold tracking-widest text-accent uppercase mb-4">Differentiators</p>
        <h2 class="text-3xl sm:text-4xl font-semibold text-ink-primary">
          What makes {appName} different
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          {
            title: 'Records, not summaries',
            desc: 'Finalized minutes are locked, hash-sealed PDFs with full approval history. Governance artifacts, not editable notes.',
            icon: '🗂️',
          },
          {
            title: 'Tamper-evident by design',
            desc: 'Every state change is cryptographically chained. If a document is altered after approval, the chain breaks immediately.',
            icon: '🔗',
          },
          {
            title: 'Acknowledgement without accounts',
            desc: 'Recipients confirm receipt through a secure email link. No signup, no login, no friction for the people reading the record.',
            icon: '✅',
          },
          {
            title: 'Cross-meeting register',
            desc: 'Decisions and actions are tracked across all meetings with ownership, status, and source meeting. Nothing falls through the cracks.',
            icon: '📊',
          },
          {
            title: 'No bot in your meeting',
            desc: 'Record on your own terms. No calendar sync, no integrations, no joining bot. Your meeting, your workflow.',
            icon: '🚫',
          },
          {
            title: 'Privacy-first architecture',
            desc: "Data isolated at the database level per organization. You control retention. No third-party analytics.",
            icon: '🔒',
          },
        ].map(({ title, desc, icon }) => (
          <div class="bg-bg-surface border border-line rounded-2xl p-6 hover:border-line-strong transition-colors">
            <div class="text-2xl mb-4">{icon}</div>
            <h3 class="text-base font-semibold text-ink-primary mb-2">{title}</h3>
            <p class="text-sm text-ink-secondary leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── USE CASES ─────────────────────────────────────── -->
  <section class="py-24 px-5 border-t border-line bg-bg-surface/30">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-semibold text-ink-primary mb-4">
          Built for teams where meetings carry weight
        </h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {[
          {
            role: 'Board secretaries & committee clerks',
            desc: 'Document motions, votes, and resolutions with verifiable records and tracked acknowledgement.',
          },
          {
            role: 'Legal & compliance teams',
            desc: 'Capture decision rationale in tamper-evident records that hold up under audit.',
          },
          {
            role: 'Consultancies & agencies',
            desc: 'Document client commitments so there is always proof of what was agreed.',
          },
          {
            role: 'Operations leads & project managers',
            desc: 'Track decisions and action items across every meeting your team runs.',
          },
        ].map(({ role, desc }) => (
          <div class="bg-bg-surface border border-line rounded-xl p-5">
            <p class="text-sm font-semibold text-ink-primary mb-2">{role}</p>
            <p class="text-xs text-ink-secondary leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── FAQ ───────────────────────────────────────────── -->
  <section id="faq" class="py-24 px-5 border-t border-line">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-xs font-semibold tracking-widest text-accent uppercase mb-4">FAQ</p>
        <h2 class="text-3xl sm:text-4xl font-semibold text-ink-primary">Frequently asked questions</h2>
      </div>

      <div class="space-y-2" id="faq-list">
        {[
          {
            q: 'What is tamper-evident meeting minutes software?',
            a: `Tamper-evident minutes are meeting records sealed with a cryptographic hash (SHA-256) at the moment of approval. Any change to the document after finalization produces a different hash, making alterations immediately detectable. ${appName} generates these sealed PDF minutes automatically, giving your organization the auditability that enterprise governance platforms provide.`,
          },
          {
            q: `Who is ${appName} built for?`,
            a: `${appName} is built for teams where meetings carry weight. Board secretaries documenting motions and resolutions. Legal and compliance teams capturing decision rationale. Consultancies recording client commitments. Operations leads tracking actions across recurring meetings. If your meetings produce decisions that need to be verified, acknowledged, or audited, ${appName} is built for you.`,
          },
          {
            q: 'How does the decision and action register work?',
            a: 'Every decision and action item extracted from your meetings feeds into a cross-meeting register. Each entry tracks its owner, status, and source meeting so nothing falls through the cracks. Filter by status, assignee, or date range to see what is open, completed, or overdue across all your meetings.',
          },
          {
            q: `What makes ${appName} different from regular meeting notes tools?`,
            a: `Most meeting tools produce summaries. ${appName} produces records. Summaries are editable documents that can change at any time. ${appName} minutes are finalized, hash-sealed PDFs with approval workflows, acknowledgement tracking, and an immutable audit trail. They are governance-grade records, not notes.`,
          },
          {
            q: 'How does the recording workflow work?',
            a: `You can record directly in your browser, upload an audio or video file, paste a transcript, or type meeting notes. ${appName} sends the text content to an AI that extracts decisions, action items, and discussion points into a structured draft. No integrations, no plugins, no calendar sync required.`,
          },
          {
            q: 'How does acknowledgement tracking work?',
            a: 'After minutes are approved, you distribute them to attendees with one click. Each recipient gets a secure email link to review the finalized minutes and confirm receipt. No account or login is required. You see exactly who has acknowledged and who has not, creating a verifiable distribution record.',
          },
          {
            q: `How much does ${appName} cost?`,
            a: `${appName} is free during the beta period with full feature access. Pricing tiers will be announced after the beta.`,
          },
        ].map(({ q, a }, i) => (
          <div class="faq-item border border-line rounded-xl overflow-hidden">
            <button
              class="faq-trigger w-full flex items-center justify-between text-left px-6 py-4 gap-4 hover:bg-bg-surface/50 transition-colors"
              aria-expanded="false"
              aria-controls={`faq-answer-${i}`}
            >
              <span class="text-sm font-medium text-ink-primary">{q}</span>
              <svg class="faq-icon w-4 h-4 text-ink-muted flex-shrink-0 transition-transform" viewBox="0 0 16 16" fill="none">
                <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <div id={`faq-answer-${i}`} class="faq-answer hidden px-6 pb-5">
              <p class="text-sm text-ink-secondary leading-relaxed">{a}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ───────────────────────────────────────────── -->
  <section class="py-24 px-5 border-t border-line">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-ink-muted text-base mb-4">A note tells you what happened.</p>
      <h2 class="text-4xl sm:text-5xl font-semibold text-ink-primary mb-6">
        A record <span class="text-accent">proves</span> it.
      </h2>
      <p class="text-ink-secondary text-lg mb-10 max-w-xl mx-auto">
        {appName} creates the records your organization can rely on.
      </p>
      <a href="/signup" class="inline-flex items-center gap-2 bg-accent hover:bg-accent-dim text-white font-medium px-8 py-3.5 rounded-xl text-base transition-all hover:shadow-lg hover:shadow-accent/20">
        Get started free
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- ── FOOTER ────────────────────────────────────────── -->
  <footer class="border-t border-line py-8 px-5">
    <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-ink-muted">
      <span class="font-medium text-ink-secondary">{appName}</span>
      <nav class="flex items-center gap-5">
        <a href="#why" class="hover:text-ink-secondary transition-colors">Why {appName}</a>
        <a href="#how" class="hover:text-ink-secondary transition-colors">How it works</a>
        <a href="#faq" class="hover:text-ink-secondary transition-colors">FAQ</a>
        <a href="/login" class="hover:text-ink-secondary transition-colors">Login</a>
      </nav>
      <span>&copy; {new Date().getFullYear()} {appName}. All rights reserved.</span>
    </div>
  </footer>
</Base>

<script>
  // FAQ accordion
  document.querySelectorAll('.faq-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      const answerId = btn.getAttribute('aria-controls')!;
      const answer = document.getElementById(answerId)!;
      const icon = btn.querySelector('.faq-icon') as HTMLElement;

      btn.setAttribute('aria-expanded', String(!expanded));
      answer.classList.toggle('hidden', expanded);
      icon.style.transform = expanded ? '' : 'rotate(180deg)';
    });
  });
</script>
