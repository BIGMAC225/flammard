---
import Dashboard from '../../layouts/Dashboard.astro';
import { createSupabaseServerClient } from '../../lib/supabase-server';

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const { data: { user } } = await supabase.auth.getUser();

const [
  { data: meetings },
  { data: rocks },
  { data: openTodos },
  { data: openIssues },
] = await Promise.all([
  supabase
    .from('meetings')
    .select('id, title, date, status, attendees')
    .eq('created_by', user!.id)
    .order('date', { ascending: false })
    .limit(8),
  supabase
    .from('rocks')
    .select('id, status')
    .eq('created_by', user!.id),
  supabase
    .from('todos')
    .select('id')
    .eq('created_by', user!.id)
    .eq('status', 'open'),
  supabase
    .from('issues')
    .select('id')
    .eq('created_by', user!.id)
    .eq('status', 'open'),
]);

const statusCounts = {
  total: meetings?.length ?? 0,
  approved: meetings?.filter(m => m.status === 'approved' || m.status === 'distributed').length ?? 0,
  draft: meetings?.filter(m => m.status === 'draft' || m.status === 'minutes_draft').length ?? 0,
  distributed: meetings?.filter(m => m.status === 'distributed').length ?? 0,
};

const rocksOnTrack = rocks?.filter(r => r.status === 'on_track').length ?? 0;
const rocksTotal = rocks?.filter(r => r.status === 'on_track' || r.status === 'off_track').length ?? 0;
const rocksPct = rocksTotal > 0 ? Math.round((rocksOnTrack / rocksTotal) * 100) : null;

const STATUS_LABEL: Record<string, string> = {
  draft: 'Draft',
  minutes_draft: 'In review',
  approved: 'Approved',
  distributed: 'Distributed',
};
const STATUS_CLASS: Record<string, string> = {
  draft: 'badge-draft',
  minutes_draft: 'badge bg-state-warning/15 text-state-warning',
  approved: 'badge-sealed',
  distributed: 'badge-distributed',
};
---

<Dashboard eyebrow="EOS" title="Dashboard" description={`Welcome back, ${user?.user_metadata?.full_name ?? user?.email}`}>
  <a slot="actions" href="/dashboard/meetings/new" class="btn-primary">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
      <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
    New meeting
  </a>

  <!-- EOS KPIs -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-10">
    <div class="stat-tile">
      <p class="stat-tile-label">Meetings</p>
      <p class="stat-tile-value">{statusCounts.total}</p>
      <p class="stat-tile-hint">{statusCounts.approved} approved · {statusCounts.draft} in progress</p>
    </div>
    <a href="/dashboard/rocks" class={`stat-tile block transition-shadow hover:shadow-lift ${rocksPct !== null && rocksPct < 70 ? 'bg-amber-50 border-amber-200' : ''}`}>
      <p class="stat-tile-label">Rocks on track</p>
      <p class={`stat-tile-value ${rocksPct !== null ? (rocksPct >= 70 ? 'text-state-success' : 'text-amber-900') : ''}`}>
        {rocksPct !== null ? `${rocksPct}%` : rocksTotal === 0 ? '—' : '0%'}
      </p>
      <p class="stat-tile-hint">{rocksOnTrack} of {rocksTotal} active</p>
    </a>
    <a href="/dashboard/todos" class="stat-tile block transition-shadow hover:shadow-lift">
      <p class="stat-tile-label">Open to-dos</p>
      <p class={`stat-tile-value ${(openTodos?.length ?? 0) > 0 ? 'text-amber-900' : ''}`}>{openTodos?.length ?? 0}</p>
      <p class="stat-tile-hint">7-day action items</p>
    </a>
    <a href="/dashboard/issues" class={`stat-tile block transition-shadow hover:shadow-lift ${(openIssues?.length ?? 0) > 0 ? 'bg-red-50 border-red-200' : ''}`}>
      <p class="stat-tile-label">Open issues</p>
      <p class={`stat-tile-value ${(openIssues?.length ?? 0) > 0 ? 'text-red-800' : ''}`}>{openIssues?.length ?? 0}</p>
      <p class="stat-tile-hint">Waiting for IDS</p>
    </a>
  </div>

  <!-- Recent meetings -->
  <div>
    <div class="flex items-center justify-between mb-4">
      <h2 class="section-title">Recent meetings</h2>
      <a href="/dashboard/meetings" class="text-sm text-accent hover:text-accent-dim transition-colors">View all →</a>
    </div>

    {!meetings?.length ? (
      <div class="card text-center py-12">
        <div class="text-4xl mb-3">📋</div>
        <p class="text-ink-secondary text-sm mb-4">No meetings yet. Create your first one.</p>
        <a href="/dashboard/meetings/new" class="btn-primary">Create meeting</a>
      </div>
    ) : (
      <div class="card p-0 overflow-hidden">
        {meetings.map(m => (
          <a
            href={`/dashboard/meetings/${m.id}`}
            class="flex items-center gap-4 px-5 py-4 border-b border-line last:border-0 hover:bg-bg-elevated/50 transition-colors"
          >
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-ink-primary truncate">{m.title}</p>
              <p class="text-xs text-ink-muted mt-0.5">{m.date} · {(m.attendees as any[])?.length ?? 0} attendee{(m.attendees as any[])?.length !== 1 ? 's' : ''}</p>
            </div>
            <span class={STATUS_CLASS[m.status] ?? 'badge-draft'}>
              {STATUS_LABEL[m.status] ?? m.status}
            </span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="text-ink-muted flex-shrink-0">
              <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        ))}
      </div>
    )}
  </div>
</Dashboard>
