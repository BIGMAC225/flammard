---
import Dashboard from '../../layouts/Dashboard.astro';
import { many, one, sql } from '../../lib/db';
import { currentTeam, teamLabel } from '../../lib/teams';
import { activateDueRocks } from '../../lib/roadmap';
import type { Attendee } from '../../types';

const team = currentTeam(Astro.cookies);
await activateDueRocks(team);
const db = sql();
const [meetings, counts] = await Promise.all([
  many<{ id: string; title: string; date: string; status: string; attendees: Attendee[] }>(
    db`select id, title, date::text as date, status, attendees from meetings where team = ${team} order by date desc, created_at desc limit 8`
  ),
  one<{
    total: number;
    approved: number;
    draft: number;
    rocks_on_track: number;
    rocks_active: number;
    open_todos: number;
    open_issues: number;
  }>(db`
    select
      (select count(*)::int from meetings where team = ${team}) as total,
      (select count(*)::int from meetings where team = ${team} and status in ('approved', 'distributed')) as approved,
      (select count(*)::int from meetings where team = ${team} and status in ('draft', 'minutes_draft')) as draft,
      (select count(*)::int from rocks where team = ${team} and status = 'on_track') as rocks_on_track,
      (select count(*)::int from rocks where team = ${team} and status in ('on_track', 'off_track')) as rocks_active,
      (select count(*)::int from todos where team = ${team} and status = 'open') as open_todos,
      (select count(*)::int from issues where team = ${team} and status = 'open' and horizon = 'short') as open_issues
  `),
]);

const c = counts!;
const rocksPct = c.rocks_active > 0 ? Math.round((c.rocks_on_track / c.rocks_active) * 100) : null;

const STATUS_LABEL: Record<string, string> = {
  draft: 'Draft',
  minutes_draft: 'In review',
  approved: 'Approved',
  distributed: 'Distributed',
};
const STATUS_CLASS: Record<string, string> = {
  draft: 'badge-draft',
  minutes_draft: 'badge bg-state-warning/15 text-state-warning',
  approved: 'badge-sealed',
  distributed: 'badge-distributed',
};
---

<Dashboard eyebrow={teamLabel(team)} title="Dashboard" description="Where this team's L10 stands this week.">
  <a slot="actions" href="/dashboard/meetings/new" class="btn-primary">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
      <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
    New meeting
  </a>

  <!-- EOS KPIs -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-10">
    <div class="stat-tile">
      <p class="stat-tile-label">Meetings</p>
      <p class="stat-tile-value">{c.total}</p>
      <p class="stat-tile-hint">{c.approved} approved · {c.draft} in progress</p>
    </div>
    <a href="/dashboard/rocks" class={`stat-tile block transition-shadow hover:shadow-lift ${rocksPct !== null && rocksPct < 70 ? 'bg-amber-50 border-amber-200' : ''}`}>
      <p class="stat-tile-label">Rocks on track</p>
      <p class={`stat-tile-value ${rocksPct !== null ? (rocksPct >= 70 ? 'text-state-success' : 'text-amber-900') : ''}`}>
        {rocksPct !== null ? `${rocksPct}%` : '—'}
      </p>
      <p class="stat-tile-hint">{c.rocks_on_track} of {c.rocks_active} active</p>
    </a>
    <a href="/dashboard/todos" class="stat-tile block transition-shadow hover:shadow-lift">
      <p class="stat-tile-label">Open to-dos</p>
      <p class={`stat-tile-value ${c.open_todos > 0 ? 'text-amber-900' : ''}`}>{c.open_todos}</p>
      <p class="stat-tile-hint">7-day action items</p>
    </a>
    <a href="/dashboard/issues" class={`stat-tile block transition-shadow hover:shadow-lift ${c.open_issues > 0 ? 'bg-red-50 border-red-200' : ''}`}>
      <p class="stat-tile-label">Open issues</p>
      <p class={`stat-tile-value ${c.open_issues > 0 ? 'text-red-800' : ''}`}>{c.open_issues}</p>
      <p class="stat-tile-hint">Waiting for IDS</p>
    </a>
  </div>
  <!-- Recent meetings -->
  <div>
    <div class="flex items-center justify-between mb-4">
      <h2 class="section-title">Recent meetings</h2>
      <a href="/dashboard/meetings" class="text-sm text-accent hover:text-accent-dim transition-colors">View all →</a>
    </div>

    {!meetings?.length ? (
      <div class="card text-center py-12">
        <div class="text-4xl mb-3">📋</div>
        <p class="text-ink-secondary text-sm mb-4">No meetings yet. Create your first one.</p>
        <a href="/dashboard/meetings/new" class="btn-primary">Create meeting</a>
      </div>
    ) : (
      <div class="card p-0 overflow-hidden">
        {meetings.map(m => (
          <a
            href={`/dashboard/meetings/${m.id}`}
            class="flex items-center gap-4 px-5 py-4 border-b border-line last:border-0 hover:bg-bg-elevated/50 transition-colors"
          >
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-ink-primary truncate">{m.title}</p>
              <p class="text-xs text-ink-muted mt-0.5">{m.date} · {m.attendees?.length ?? 0} attendee{m.attendees?.length !== 1 ? 's' : ''}</p>
            </div>
            <span class={STATUS_CLASS[m.status] ?? 'badge-draft'}>
              {STATUS_LABEL[m.status] ?? m.status}
            </span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="text-ink-muted flex-shrink-0">
              <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        ))}
      </div>
    )}
  </div>
</Dashboard>
