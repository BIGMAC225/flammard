---
import Dashboard from '../../layouts/Dashboard.astro';
import DecisionRegister from '../../components/DecisionRegister';
import { many, sql } from '../../lib/db';
import type { Decision, ActionItem } from '../../types';

// All approved minutes + their meetings
const rows = await many<{
  id: string;
  decisions: Decision[];
  actions: ActionItem[];
  meetings: { id: string; title: string; date: string };
}>(sql()`
  select mi.id, mi.decisions, mi.actions,
         jsonb_build_object('id', m.id, 'title', m.title, 'date', m.date::text) as meetings
  from minutes mi join meetings m on m.id = mi.meeting_id
  where mi.sealed_at is not null
`);

// Flatten to register entries
const entries: Array<{
  id: string;
  meeting_id: string;
  meeting_title: string;
  meeting_date: string;
  type: 'decision' | 'action';
  text: string;
  outcome?: string;
  owner?: string;
  due_date?: string;
  status?: string;
}> = [];

for (const row of rows) {
  const m = row.meetings;

  for (const d of (row.decisions as Decision[]) ?? []) {
    entries.push({
      id: d.id,
      meeting_id: m.id,
      meeting_title: m.title,
      meeting_date: m.date,
      type: 'decision',
      text: d.text,
      outcome: d.outcome,
    });
  }

  for (const a of (row.actions as ActionItem[]) ?? []) {
    entries.push({
      id: a.id,
      meeting_id: m.id,
      meeting_title: m.title,
      meeting_date: m.date,
      type: 'action',
      text: a.text,
      owner: a.owner,
      due_date: a.due_date,
      status: a.status,
    });
  }
}

// Sort by meeting date desc
entries.sort((a, b) => b.meeting_date.localeCompare(a.meeting_date));
---

<Dashboard eyebrow="Records" title="Decision & Action Register" description="All decisions and action items from approved meetings, in one place.">
  <DecisionRegister entries={entries} client:load />
</Dashboard>
