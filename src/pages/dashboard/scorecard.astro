---
import Dashboard from '../../layouts/Dashboard.astro';
import ScorecardManager from '../../components/ScorecardManager';
import { createSupabaseServerClient } from '../../lib/supabase-server';
import type { ScorecardEntry, ScorecardMetric, TaxDomeImport } from '../../types';

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);

const [{ data: metrics }, { data: entries }, { data: imports }] = await Promise.all([
  supabase.from('scorecard_metrics').select('*').eq('active', true).order('sort_order').order('created_at'),
  supabase
    .from('scorecard_entries')
    .select('*')
    .not('period_date', 'is', null)
    .order('period_date', { ascending: false })
    .limit(500),
  supabase.from('taxdome_imports').select('*').order('received_at', { ascending: false }).limit(10),
]);

const typedMetrics = (metrics ?? []) as ScorecardMetric[];
const typedEntries = (entries ?? []) as ScorecardEntry[];
const typedImports = (imports ?? []) as TaxDomeImport[];

// Most recent 8 reporting periods that have any data
const periods = [...new Set(typedEntries.map((e) => e.period_date!))].slice(0, 8);

const webhookUrl = `${import.meta.env.PUBLIC_APP_URL || Astro.url.origin}/api/integrations/taxdome`;
---

<Dashboard title="Scorecard">
  <div class="flex items-start justify-between gap-4 mb-8 -mt-2">
    <p class="text-sm text-ink-secondary">
      Weekly measurables. Values marked <span class="font-mono text-xs text-ink-muted">TD</span> were imported from TaxDome.
    </p>
  </div>

  <ScorecardManager metrics={typedMetrics} entries={typedEntries} periods={periods} client:load />

  <!-- ── TaxDome imports ─────────────────────────────── -->
  <section class="mt-12">
    <div class="flex items-start justify-between gap-4 mb-4">
      <div>
        <h2 class="text-base font-semibold text-ink-primary">TaxDome imports</h2>
        <p class="text-sm text-ink-secondary mt-0.5">
          Reports received through the Zapier webhook. Setup steps are in <span class="font-mono text-xs">docs/AUTOMATION.md</span>.
        </p>
      </div>
    </div>

    <div class="card mb-4">
      <p class="text-xs font-semibold text-ink-muted uppercase tracking-wide mb-1">Webhook URL</p>
      <p class="font-mono text-xs text-ink-secondary break-all">{webhookUrl}</p>
      <p class="text-xs text-ink-muted mt-2">
        Send the PDF as a file with header <span class="font-mono">Authorization: Bearer &lt;TAXDOME_WEBHOOK_SECRET&gt;</span>.
      </p>
    </div>

    {typedImports.length === 0 ? (
      <p class="text-sm text-ink-muted">No reports received yet.</p>
    ) : (
      <div class="border border-line rounded-xl overflow-hidden">
        {typedImports.map((imp, i) => (
          <div class={`px-5 py-4 ${i < typedImports.length - 1 ? 'border-b border-line' : ''}`}>
            <div class="flex items-center gap-3">
              <span class={imp.status === 'processed' ? 'badge bg-state-success/15 text-state-success' : 'badge bg-state-danger/15 text-state-danger'}>
                {imp.status === 'processed' ? 'Processed' : 'Failed'}
              </span>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-ink-primary truncate">
                  {imp.report_title ?? imp.file_name ?? 'Report'}
                </p>
                <p class="text-xs text-ink-muted">
                  {new Date(imp.received_at).toLocaleString()}
                  {imp.period_end && ` · period ending ${imp.period_end}`}
                  {imp.status === 'processed' && ` · ${imp.entries_written} value${imp.entries_written === 1 ? '' : 's'} written`}
                </p>
              </div>
            </div>
            {imp.error && <p class="text-xs text-state-danger mt-2">{imp.error}</p>}
            {imp.extracted?.unmatched?.length ? (
              <details class="mt-2">
                <summary class="text-xs text-ink-muted cursor-pointer hover:text-ink-primary">
                  {imp.extracted.unmatched.length} figure{imp.extracted.unmatched.length === 1 ? '' : 's'} in the report not mapped to a metric
                </summary>
                <ul class="mt-2 space-y-0.5">
                  {imp.extracted.unmatched.map((u) => (
                    <li class="text-xs text-ink-secondary"><span class="text-ink-muted">{u.label}:</span> {u.value}</li>
                  ))}
                </ul>
              </details>
            ) : null}
          </div>
        ))}
      </div>
    )}
  </section>
</Dashboard>
