---
import Dashboard from '../../../layouts/Dashboard.astro';
import { many, sql } from '../../../lib/db';
import type { Attendee } from '../../../types';

const meetings = await many<{ id: string; title: string; date: string; location: string | null; status: string; attendees: Attendee[] }>(
  sql()`select id, title, date::text as date, location, status, attendees from meetings order by date desc, created_at desc`
);

const STATUS_LABEL: Record<string, string> = {
  draft: 'Draft',
  minutes_draft: 'In review',
  approved: 'Approved',
  distributed: 'Distributed',
};
const STATUS_CLASS: Record<string, string> = {
  draft: 'badge-draft',
  minutes_draft: 'badge bg-state-warning/15 text-state-warning',
  approved: 'badge-sealed',
  distributed: 'badge-distributed',
};
---

<Dashboard eyebrow="Records" title="Meetings" description={`${meetings?.length ?? 0} meeting${meetings?.length !== 1 ? 's' : ''} on file.`}>
  <a slot="actions" href="/dashboard/meetings/new" class="btn-primary">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none">
      <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
    New meeting
  </a>

  {!meetings?.length ? (
    <div class="card text-center py-16">
      <div class="text-5xl mb-4">📋</div>
      <p class="text-lg font-medium text-ink-primary mb-2">No meetings yet</p>
      <p class="text-sm text-ink-secondary mb-6">Create your first meeting to get started.</p>
      <a href="/dashboard/meetings/new" class="btn-primary">Create meeting</a>
    </div>
  ) : (
    <div class="card p-0 overflow-hidden">
      <table class="table-brand">
        <thead>
          <tr>
            <th>Meeting</th>
            <th class="hidden md:table-cell">Date</th>
            <th class="hidden sm:table-cell">Attendees</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {meetings.map(m => (
            <tr>
              <td class="px-5 py-3.5">
                <a href={`/dashboard/meetings/${m.id}`} class="font-medium text-ink-primary hover:text-accent transition-colors">
                  {m.title}
                </a>
                {m.location && <p class="text-xs text-ink-muted mt-0.5">{m.location}</p>}
              </td>
              <td class="px-5 py-3.5 text-ink-secondary hidden md:table-cell">{m.date}</td>
              <td class="px-5 py-3.5 text-ink-secondary hidden sm:table-cell">
                {m.attendees?.length ?? 0}
              </td>
              <td class="px-5 py-3.5">
                <span class={STATUS_CLASS[m.status] ?? 'badge-draft'}>
                  {STATUS_LABEL[m.status] ?? m.status}
                </span>
              </td>
              <td class="px-5 py-3.5 text-right">
                <a href={`/dashboard/meetings/${m.id}`} class="text-ink-muted hover:text-accent transition-colors text-xs">
                  Open →
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</Dashboard>
