---
import Dashboard from '../../../layouts/Dashboard.astro';
import MinutesDraftEditor from '../../../components/MinutesDraftEditor';
import RocksPanel from '../../../components/RocksPanel';
import TodoPanel from '../../../components/TodoPanel';
import IssuesPanel from '../../../components/IssuesPanel';
import HeadlinesPanel from '../../../components/HeadlinesPanel';
import { createSupabaseServerClient } from '../../../lib/supabase-server';
import type { Minutes, MeetingRock, Todo, Issue, Headline, Attendee } from '../../../types';

const { id } = Astro.params;
const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const { data: { user } } = await supabase.auth.getUser();

if (!id) return Astro.redirect('/dashboard/meetings');

const { data: meeting, error } = await supabase
  .from('meetings')
  .select('*')
  .eq('id', id)
  .single();

if (error || !meeting || meeting.created_by !== user!.id) {
  return Astro.redirect('/dashboard/meetings');
}

const [
  { data: minutes },
  { data: meetingRocks },
  { data: todos },
  { data: issues },
  { data: headlines },
  { data: approvalData },
] = await Promise.all([
  supabase.from('minutes').select('*').eq('meeting_id', id).maybeSingle(),
  supabase.from('meeting_rocks').select('*').eq('meeting_id', id).order('created_at'),
  supabase.from('todos').select('*').eq('meeting_id', id).order('created_at'),
  supabase.from('issues').select('*').eq('meeting_id', id).order('created_at'),
  supabase.from('headlines').select('*').eq('meeting_id', id).order('created_at'),
  supabase.from('approvals').select('approved_by_email, approved_at').eq('minutes_id', (await supabase.from('minutes').select('id').eq('meeting_id', id).maybeSingle()).data?.id ?? '').maybeSingle(),
]);

const typedMinutes = minutes as Minutes | null;
const attendees = (meeting.attendees as Attendee[]) ?? [];

const STATUS_LABEL: Record<string, string> = {
  draft: 'Draft',
  minutes_draft: 'In review',
  approved: 'Approved',
  distributed: 'Approved',
};
const STATUS_CLASS: Record<string, string> = {
  draft: 'badge-draft',
  minutes_draft: 'badge bg-state-warning/15 text-state-warning',
  approved: 'badge-sealed',
  distributed: 'badge-sealed',
};

const activeTab = new URL(Astro.request.url).searchParams.get('tab') ?? 'eos';
---

<Dashboard title={meeting.title} back={{ href: '/dashboard/meetings', label: 'Meetings' }}>

  <!-- Meeting meta -->
  <div class="flex flex-wrap items-center gap-3 mb-2 -mt-2">
    <span class={STATUS_CLASS[meeting.status] ?? 'badge-draft'}>
      {STATUS_LABEL[meeting.status] ?? meeting.status}
    </span>
    <span class="text-sm text-ink-secondary">{meeting.date}</span>
    {meeting.location && <span class="text-sm text-ink-muted">{meeting.location}</span>}
    {attendees.length > 0 && (
      <span class="text-sm text-ink-muted">{attendees.length} attendee{attendees.length !== 1 ? 's' : ''}</span>
    )}
    {meeting.meeting_rating != null && (
      <span class="text-sm text-ink-muted">Rating: {meeting.meeting_rating}/10</span>
    )}
  </div>

  {attendees.length > 0 && (
    <p class="text-xs text-ink-muted mb-6">
      {attendees.map((a: Attendee) => a.name).join(' · ')}
    </p>
  )}

  <!-- Tab bar -->
  <div class="flex gap-1 p-1 bg-bg-elevated rounded-xl w-fit mb-6">
    {[
      { id: 'eos', label: 'EOS Sections' },
      { id: 'minutes', label: 'Minutes' },
    ].map(tab => (
      <a
        href={`?tab=${tab.id}`}
        class={`px-4 py-2 rounded-lg text-sm font-medium transition-colors ${
          activeTab === tab.id
            ? 'bg-bg-surface text-ink-primary shadow-sm'
            : 'text-ink-secondary hover:text-ink-primary'
        }`}
      >
        {tab.label}
      </a>
    ))}
  </div>

  <!-- ── EOS SECTIONS ───────────────────────────────────── -->
  {activeTab === 'eos' && (
    <div class="space-y-6">

      <section class="card">
        <h2 class="text-base font-semibold text-ink-primary mb-1">Headlines</h2>
        <p class="text-sm text-ink-secondary mb-4">Customer wins, employee wins, and good news.</p>
        <HeadlinesPanel meetingId={id} initialHeadlines={headlines ?? []} client:load />
      </section>

      <section class="card">
        <div class="flex items-start justify-between mb-4">
          <div>
            <h2 class="text-base font-semibold text-ink-primary">Rocks</h2>
            <p class="text-sm text-ink-secondary mt-0.5">Quarterly goals reviewed at this meeting.</p>
          </div>
          <a href="/dashboard/rocks" class="text-xs text-accent hover:text-accent-dim transition-colors">All rocks →</a>
        </div>
        <RocksPanel meetingId={id} initialRocks={meetingRocks ?? []} client:load />
      </section>

      <section class="card">
        <div class="flex items-start justify-between mb-4">
          <div>
            <h2 class="text-base font-semibold text-ink-primary">To-Dos</h2>
            <p class="text-sm text-ink-secondary mt-0.5">7-day action items for this meeting.</p>
          </div>
          <a href="/dashboard/todos" class="text-xs text-accent hover:text-accent-dim transition-colors">All to-dos →</a>
        </div>
        <TodoPanel meetingId={id} initialTodos={todos ?? []} client:load />
      </section>

      <section class="card">
        <div class="flex items-start justify-between mb-4">
          <div>
            <h2 class="text-base font-semibold text-ink-primary">Issues (IDS)</h2>
            <p class="text-sm text-ink-secondary mt-0.5">Issues identified, discussed, and solved.</p>
          </div>
          <a href="/dashboard/issues" class="text-xs text-accent hover:text-accent-dim transition-colors">All issues →</a>
        </div>
        <IssuesPanel meetingId={id} initialIssues={issues ?? []} client:load />
      </section>

      {meeting.conclude_notes && (
        <section class="card">
          <h2 class="text-base font-semibold text-ink-primary mb-3">Conclude Notes</h2>
          <p class="text-sm text-ink-secondary leading-relaxed">{meeting.conclude_notes}</p>
        </section>
      )}

    </div>
  )}

  <!-- ── MINUTES ────────────────────────────────────────── -->
  {activeTab === 'minutes' && (
    <div class="space-y-6">
      <section class="card">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-base font-semibold text-ink-primary">
              {typedMinutes?.sealed_at ? 'Sealed minutes' : 'Meeting minutes'}
            </h2>
            {typedMinutes?.sealed_at && (
              <p class="font-mono text-xs text-ink-muted mt-1 break-all">SHA-256: {typedMinutes.content_hash}</p>
            )}
            {approvalData && (
              <p class="text-xs text-ink-muted mt-0.5">
                Approved by {approvalData.approved_by_email} · {new Date(approvalData.approved_at).toLocaleString()}
              </p>
            )}
          </div>
          {typedMinutes?.sealed_at && (
            <div class="flex items-center gap-2 flex-shrink-0">
              <div class="flex items-center gap-1.5 text-xs text-accent">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none">
                  <rect x="3" y="11" width="18" height="11" rx="2" stroke="currentColor" strokeWidth="1.5"/>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round"/>
                </svg>
                Sealed
              </div>
              {typedMinutes.pdf_path && (
                <a href={`/api/meetings/${id}/pdf`} class="btn-secondary text-xs py-1.5">
                  Download PDF
                </a>
              )}
            </div>
          )}
        </div>

        <MinutesDraftEditor
          meetingId={id}
          initialSummary={typedMinutes?.summary ?? ''}
          initialDecisions={typedMinutes?.decisions ?? []}
          initialActions={typedMinutes?.actions ?? []}
          initialDiscussion={typedMinutes?.discussion ?? []}
          isSealed={!!typedMinutes?.sealed_at}
          client:load
        />
      </section>
    </div>
  )}

</Dashboard>
