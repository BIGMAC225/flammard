---
import Dashboard from '../../layouts/Dashboard.astro';
import IssuesBoard, { type BoardIssue } from '../../components/IssuesBoard';
import { many, sql } from '../../lib/db';
import { stepsForMany } from '../../lib/steps';
import { currentTeam, teamLabel } from '../../lib/teams';

const team = currentTeam(Astro.cookies);
const issues = await many<BoardIssue>(sql()`
  select i.*, i.created_at::text as created_at, i.updated_at::text as updated_at,
         m.title as meeting_title, m.date::text as meeting_date
  from issues i left join meetings m on m.id = i.meeting_id
  where i.team = ${team}
  order by i.horizon, i.rank nulls last, i.created_at
`);

const open = issues.filter((i) => i.status === 'open');
const closed = issues
  .filter((i) => i.status !== 'open')
  .sort((a, b) => String(b.updated_at).localeCompare(String(a.updated_at)));
const solvedCount = closed.filter((i) => i.status === 'solved').length;
const droppedCount = closed.length - solvedCount;
const shortOpen = open.filter((i) => i.horizon === 'short').length;
const longOpen = open.length - shortOpen;
const stepsByIssue = await stepsForMany('issue', open.map((i) => i.id));
const initialTab = Astro.url.searchParams.get('list') === 'long' ? 'long' : 'short';
---

<Dashboard eyebrow={teamLabel(team)} title="Issues" description="Ranked IDS list, plus the long-term issues you have parked.">
  {shortOpen > 0 && (
    <div slot="actions" class="text-right">
      <div class="font-display text-3xl font-semibold tracking-tight text-red-800 tabular-nums">{shortOpen}</div>
      <div class="eyebrow">open short-term</div>
    </div>
  )}

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
    {[
      { label: 'Short-term', val: shortOpen, cls: 'text-state-danger' },
      { label: 'Long-term', val: longOpen, cls: 'text-state-warning' },
      { label: 'Solved', val: solvedCount, cls: 'text-state-success' },
      { label: 'Dropped', val: droppedCount, cls: 'text-ink-muted' },
    ].map(({ label, val, cls }) => (
      <div class="stat-tile">
        <p class="stat-tile-label">{label}</p>
        <p class={`stat-tile-value ${cls}`}>{val}</p>
      </div>
    ))}
  </div>

  <IssuesBoard initialIssues={open} stepsByIssue={stepsByIssue} initialTab={initialTab} client:load />

  {closed.length > 0 && (
    <details class="mt-10">
      <summary class="text-xs font-semibold text-ink-muted uppercase tracking-wide cursor-pointer select-none">
        Solved &amp; dropped <span class="font-normal ml-1">({closed.length})</span>
      </summary>
      <div class="border border-line rounded-xl overflow-hidden mt-2">
        {closed.map((issue, i) => (
          <div class={`flex items-start gap-4 px-5 py-3 ${i < closed.length - 1 ? 'border-b border-line' : ''}`}>
            <div class={`w-2 h-2 rounded-full flex-shrink-0 mt-1.5 ${issue.status === 'solved' ? 'bg-state-success' : 'bg-ink-muted'}`} />
            <div class="flex-1 min-w-0">
              <p class="text-sm text-ink-secondary">{issue.title}</p>
              {issue.resolution && <p class="text-xs text-ink-muted mt-0.5">↳ {issue.resolution}</p>}
            </div>
            <span class={issue.status === 'solved' ? 'badge bg-state-success/15 text-state-success' : 'badge bg-bg-elevated text-ink-muted'}>
              {issue.status === 'solved' ? 'Solved' : 'Dropped'}
            </span>
          </div>
        ))}
      </div>
    </details>
  )}
</Dashboard>
