---
import Dashboard from '../../layouts/Dashboard.astro';
import TodosBoard, { type BoardTodo } from '../../components/TodosBoard';
import { principal } from '../../lib/api';
import { many, sql } from '../../lib/db';
import { listPeopleOptions } from '../../lib/people';
import { stepsForMany } from '../../lib/steps';
import { currentTeam, teamLabel } from '../../lib/teams';

const team = currentTeam(Astro.cookies);
const todos = await many<BoardTodo>(sql()`
  select t.*, t.created_at::text as created_at, t.updated_at::text as updated_at,
         m.title as meeting_title, m.date::text as meeting_date
  from todos t left join meetings m on m.id = t.meeting_id
  where t.team = ${team}
  order by t.created_at desc
`);

const open = todos.filter((t) => t.status === 'open');
const done = todos.filter((t) => t.status === 'done');
const notDone = todos.filter((t) => t.status === 'not_done');
const dropped = todos.filter((t) => t.status === 'dropped');
const [stepsByTodo, people] = await Promise.all([stepsForMany('todo', open.map((t) => t.id)), listPeopleOptions(true)]);
// A new to-do starts owned by the signed-in person (unassigned for the shared login)
const me = principal(Astro.locals);
const defaultOwner = me.kind === 'person' ? { owner_id: me.id, owner: me.name } : { owner_id: null, owner: null };
---

<Dashboard eyebrow={teamLabel(team)} title="To-Dos" description="7-day action items: from L10 meetings or added here.">
  {open.length > 0 && (
    <div slot="actions" class="text-right">
      <div class="font-display text-3xl font-semibold tracking-tight text-amber-900 tabular-nums">{open.length}</div>
      <div class="eyebrow">open</div>
    </div>
  )}

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
    {[
      { label: 'Open', val: open.length, cls: 'text-state-warning' },
      { label: 'Done', val: done.length, cls: 'text-state-success' },
      { label: 'Not Done', val: notDone.length, cls: 'text-state-danger' },
      { label: 'Dropped', val: dropped.length, cls: 'text-ink-muted' },
    ].map(({ label, val, cls }) => (
      <div class="stat-tile">
        <p class="stat-tile-label">{label}</p>
        <p class={`stat-tile-value ${cls}`}>{val}</p>
      </div>
    ))}
  </div>

  <TodosBoard initialTodos={open} stepsByTodo={stepsByTodo} team={team} people={people} defaultOwner={defaultOwner} client:load />

  <div class="space-y-6 mt-8">
    {notDone.length > 0 && (
      <div>
        <p class="text-xs font-semibold text-ink-muted uppercase tracking-wide mb-2">
          Not Done <span class="font-normal ml-1">({notDone.length})</span>
        </p>
        <div class="border border-line rounded-xl overflow-hidden">
          {notDone.map((todo, i) => (
            <div class={`flex items-center gap-4 px-5 py-3 ${i < notDone.length - 1 ? 'border-b border-line' : ''}`}>
              <div class="flex-1 min-w-0">
                <p class="text-sm text-ink-secondary truncate">{todo.title}</p>
                {todo.owner && <p class="text-xs text-ink-muted mt-0.5">{todo.owner}</p>}
              </div>
              <span class="badge bg-state-danger/15 text-state-danger">Not Done</span>
            </div>
          ))}
        </div>
      </div>
    )}

    {done.length > 0 && (
      <details>
        <summary class="text-xs font-semibold text-ink-muted uppercase tracking-wide cursor-pointer select-none">
          Done <span class="font-normal ml-1">({done.length})</span>
        </summary>
        <div class="border border-line rounded-xl overflow-hidden mt-2">
          {done.map((todo, i) => (
            <div class={`flex items-center gap-4 px-5 py-3 ${i < done.length - 1 ? 'border-b border-line' : ''}`}>
              <div class="flex-1 min-w-0">
                <p class="text-sm text-ink-muted line-through truncate">{todo.title}</p>
                {todo.owner && <p class="text-xs text-ink-muted mt-0.5">{todo.owner}</p>}
              </div>
              <span class="badge bg-state-success/15 text-state-success">Done</span>
            </div>
          ))}
        </div>
      </details>
    )}
  </div>
</Dashboard>
