---
import Dashboard from '../../layouts/Dashboard.astro';
import RoadmapImport from '../../components/RoadmapImport';
import StepsPanel from '../../components/StepsPanel';
import { AddPeriod, AddRock, RockControls } from '../../components/RoadmapEditor';
import { loadRoadmap } from '../../lib/roadmap';
import { stepsForMany } from '../../lib/steps';
import { currentTeam, teamLabel } from '../../lib/teams';
import type { Period } from '../../types';

const team = currentTeam(Astro.cookies);
const { periods, unplaced } = await loadRoadmap(team);
const periodList: Period[] = periods.map(({ id, team, name, start_date, end_date, created_at }) => ({ id, team, name, start_date, end_date, created_at }));

// Steps for every rock that still shows a checklist (current and future periods)
const liveRockIds = periods.filter((p) => p.when !== 'past').flatMap((p) => p.rocks.map((r) => r.id));
const stepsByRock = await stepsForMany('rock', liveRockIds);

// Group periods by the year they start in
const years = [...new Set(periods.map((p) => p.start_date.slice(0, 4)))];
const byYear = (y: string) => periods.filter((p) => p.start_date.slice(0, 4) === y);

const fmt = (d: string) => new Date(`${d}T00:00:00`).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
const STATUS_TEXT: Record<string, string> = { planned: 'Planned', on_track: 'On track', off_track: 'Off track', complete: 'Complete', dropped: 'Dropped' };
const STATUS_DOT: Record<string, string> = {
  planned: 'bg-warm-300',
  on_track: 'bg-mint-500',
  off_track: 'bg-red-500',
  complete: 'bg-blue-600',
  dropped: 'bg-warm-300',
};
const totalRocks = periods.reduce((n, p) => n + p.rocks.length, 0) + unplaced.length;
---

<Dashboard eyebrow={teamLabel(team)} title="Roadmap" description="The multi-year plan: each period's rocks, and the steps under them.">
  <div slot="actions" class="flex flex-wrap gap-2">
    <RoadmapImport client:load />
    <AddPeriod client:load />
  </div>

  {periods.length === 0 && unplaced.length === 0 ? (
    <div class="card text-center py-14">
      <p class="text-lg font-medium text-ink-primary mb-2">No roadmap yet</p>
      <p class="text-sm text-ink-secondary max-w-md mx-auto">
        Import the plan from your deck or document, or add periods by hand (“Aug–Nov 2026”) and put 2–3 rocks in each.
      </p>
    </div>
  ) : (
    <div class="space-y-10">
      {years.map((year) => (
        <section>
          <h2 class="font-display text-2xl font-semibold tracking-tight text-ink-primary mb-4">{year}</h2>
          <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
            {byYear(year).map((p) => (
              <div class={`rounded-2xl border p-5 flex flex-col gap-3 ${
                p.when === 'current' ? 'border-accent bg-bg-surface shadow-lift' : p.when === 'past' ? 'border-line/70 bg-bg-elevated/60' : 'border-line/70 bg-bg-surface shadow-card'
              }`}>
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <p class="eyebrow">{p.when === 'current' ? 'Now' : p.when === 'past' ? 'Done' : 'Ahead'}</p>
                    <h3 class="font-display text-lg font-semibold tracking-tight text-ink-primary">{p.name}</h3>
                    <p class="text-xs text-ink-muted">{fmt(p.start_date)} – {fmt(p.end_date)}</p>
                  </div>
                  <span class="text-xs text-ink-muted whitespace-nowrap">{p.rocks.length} rock{p.rocks.length === 1 ? '' : 's'}</span>
                </div>

                {p.rocks.length === 0 && <p class="text-sm text-ink-muted">No rocks yet.</p>}

                {p.rocks.map((r) => (
                  <div class={`rounded-xl border border-line/70 bg-bg-surface px-4 py-3 ${r.status === 'dropped' ? 'opacity-60' : ''}`}>
                    <div class="flex items-start gap-2.5">
                      <span class={`w-2 h-2 rounded-full mt-1.5 flex-shrink-0 ${STATUS_DOT[r.status]}`} title={STATUS_TEXT[r.status]} />
                      <div class="flex-1 min-w-0">
                        <p class={`text-sm font-medium ${r.status === 'complete' || r.status === 'dropped' ? 'text-ink-secondary' : 'text-ink-primary'}`}>{r.title}</p>
                        <p class="text-xs text-ink-muted mt-0.5">
                          {[r.owner, r.steps_total ? `${r.steps_done}/${r.steps_total} steps` : null].filter(Boolean).join(' · ')}
                        </p>
                        {r.steps_total > 0 && (
                          <div class="h-1 rounded-full bg-bg-elevated overflow-hidden mt-1.5">
                            <div class="h-full bg-mint-500" style={`width:${Math.round((r.steps_done / r.steps_total) * 100)}%`} />
                          </div>
                        )}
                        {r.notes && <p class="text-xs text-ink-secondary mt-1.5">{r.notes}</p>}
                        <div class="mt-2">
                          <RockControls rockId={r.id} status={r.status} periodId={r.period_id} periods={periodList} client:visible />
                        </div>
                        {p.when !== 'past' && (
                          <StepsPanel type="rock" parentId={r.id} parentTitle={r.title} initialSteps={stepsByRock[r.id] ?? []} client:visible />
                        )}
                      </div>
                    </div>
                  </div>
                ))}

                <AddRock periods={periodList} defaultPeriodId={p.id} client:visible />
              </div>
            ))}
          </div>
        </section>
      ))}

      {unplaced.length > 0 && (
        <section>
          <h2 class="font-display text-2xl font-semibold tracking-tight text-ink-primary mb-1">Not on the timeline</h2>
          <p class="text-sm text-ink-secondary mb-4">Rocks without a period — give each one a period from its controls.</p>
          <div class="card p-0 overflow-hidden">
            {unplaced.map((r, i) => (
              <div class={`px-5 py-4 ${i < unplaced.length - 1 ? 'border-b border-line' : ''}`}>
                <div class="flex items-start gap-3">
                  <span class={`w-2 h-2 rounded-full mt-1.5 flex-shrink-0 ${STATUS_DOT[r.status]}`} />
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-ink-primary">{r.title}</p>
                    {r.owner && <p class="text-xs text-ink-muted">{r.owner}</p>}
                    <div class="mt-2">
                      <RockControls rockId={r.id} status={r.status} periodId={null} periods={periodList} client:visible />
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      {periods.length > 0 && (
        <p class="text-xs text-ink-muted">{totalRocks} rock{totalRocks === 1 ? '' : 's'} across {periods.length} period{periods.length === 1 ? '' : 's'}.</p>
      )}
    </div>
  )}
</Dashboard>
