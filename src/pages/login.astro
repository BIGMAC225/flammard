---
import Base from '../layouts/Base.astro';
const appName = import.meta.env.PUBLIC_APP_NAME || 'Flammard';
const next = Astro.url.searchParams.get('next') ?? '/dashboard';
---

<Base title="Sign in">
  <div class="min-h-screen flex items-center justify-center px-4 py-16">
    <div class="w-full max-w-sm">
      <p class="block text-center font-semibold text-ink-primary text-lg mb-8">{appName}</p>

      <div class="bg-bg-surface border border-line rounded-2xl p-8">
        <h1 class="text-xl font-semibold text-ink-primary mb-1">Welcome back</h1>
        <p class="text-sm text-ink-secondary mb-6">Sign in to your account</p>

        <div id="error-msg" class="hidden mb-4 p-3 bg-state-danger/10 border border-state-danger/20 rounded-lg text-sm text-state-danger"></div>

        <form id="login-form" class="space-y-4">
          <input type="hidden" name="next" value={next} />

          <div>
            <label class="label" for="password">Password</label>
            <input id="password" name="password" type="password" required autocomplete="current-password" class="input" placeholder="••••••••" autofocus />
          </div>

          <button type="submit" id="submit-btn" class="btn-primary w-full justify-center py-3">
            Sign in
          </button>
        </form>
      </div>
    </div>
  </div>
</Base>

<script>
  const form = document.getElementById('login-form') as HTMLFormElement;
  const errorMsg = document.getElementById('error-msg') as HTMLDivElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMsg.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Signing in…';

    const data = new FormData(form);
    const res = await fetch('/api/auth/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        password: data.get('password'),
        next: data.get('next'),
      }),
    });

    const json = await res.json();

    if (!res.ok) {
      errorMsg.textContent = json.error ?? 'Sign in failed';
      errorMsg.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Sign in';
    } else {
      window.location.href = json.next ?? '/dashboard';
    }
  });
</script>
