---
import Base from '../layouts/Base.astro';
import { BRAND } from '../config/brand';
import { sharedLoginEnabled } from '../lib/auth';

const next = Astro.url.searchParams.get('next') ?? '/dashboard';
// While the team password is still on (SHARED_PASSWORD_LOGIN unset or 'on'),
// it stays available behind a toggle so nobody is locked out during rollout.
const shared = sharedLoginEnabled();
---

<Base title="Sign in">
  <div class="min-h-screen flex items-center justify-center px-4 py-16">
    <div class="w-full max-w-sm animate-fade-up">
      <div class="flex items-center justify-center gap-2 mb-8">
        <span class="w-2.5 h-2.5 rounded-full bg-mint-500"></span>
        <p class="font-display font-semibold text-ink-primary text-xl tracking-tight">{BRAND.name}</p>
      </div>

      <div class="card p-8">
        <p class="eyebrow mb-2">Sign in</p>
        <h1 class="font-display text-2xl font-semibold tracking-tight text-ink-primary mb-1">Welcome back</h1>
        <p class="text-sm text-ink-secondary mb-6">{BRAND.tagline}</p>

        <div id="error-msg" role="alert" class="hidden mb-4 p-3 bg-red-50 border border-red-200 rounded-xl text-sm text-red-800"></div>

        <!-- Personal sign-in -->
        <form id="person-form" class="space-y-4" data-login-form>
          <input type="hidden" name="next" value={next} />
          <div>
            <label class="label" for="email">Work email</label>
            <input id="email" name="email" type="email" required autocomplete="username" class="input" placeholder="you@example.com" autofocus />
          </div>
          <div>
            <label class="label" for="password">Password</label>
            <input id="password" name="password" type="password" required autocomplete="current-password" class="input" placeholder="••••••••" />
          </div>
          <button type="submit" class="btn-primary w-full justify-center py-3">Sign in</button>
          <p class="text-xs text-ink-muted text-center">Forgot your password? Ask an admin for a reset link.</p>
        </form>

        {shared && (
          <>
            <!-- The old team password, during rollout -->
            <form id="shared-form" class="space-y-4 hidden" data-login-form>
              <input type="hidden" name="next" value={next} />
              <div>
                <label class="label" for="team-password">Team password</label>
                <input id="team-password" name="password" type="password" required autocomplete="current-password" class="input" placeholder="••••••••" />
              </div>
              <button type="submit" class="btn-primary w-full justify-center py-3">Sign in with the team password</button>
            </form>
            <div class="mt-5 pt-4 border-t border-line/70 text-center">
              <button type="button" id="toggle-shared" class="text-xs font-semibold text-accent hover:underline">
                Use the team password
              </button>
            </div>
          </>
        )}
      </div>
    </div>
  </div>
</Base>

<script>
  const errorMsg = document.getElementById('error-msg') as HTMLDivElement;
  const personForm = document.getElementById('person-form') as HTMLFormElement;
  const sharedForm = document.getElementById('shared-form') as HTMLFormElement | null;
  const toggle = document.getElementById('toggle-shared') as HTMLButtonElement | null;

  toggle?.addEventListener('click', () => {
    const showShared = sharedForm!.classList.contains('hidden');
    sharedForm!.classList.toggle('hidden', !showShared);
    personForm.classList.toggle('hidden', showShared);
    toggle.textContent = showShared ? 'Sign in with your email instead' : 'Use the team password';
    errorMsg.classList.add('hidden');
    (showShared ? sharedForm! : personForm).querySelector<HTMLInputElement>('input:not([type=hidden])')?.focus();
  });

  document.querySelectorAll<HTMLFormElement>('[data-login-form]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorMsg.classList.add('hidden');
      const button = form.querySelector('button[type=submit]') as HTMLButtonElement;
      const label = button.textContent;
      button.disabled = true;
      button.textContent = 'Signing in…';

      const data = new FormData(form);
      const body: Record<string, unknown> = { password: data.get('password'), next: data.get('next') };
      if (data.has('email')) body.email = data.get('email');

      let res: Response | null = null;
      let json: { error?: string; next?: string } = {};
      try {
        res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        json = await res.json().catch(() => ({}));
      } catch {
        json = { error: 'Could not reach the server. Check your connection and try again.' };
      }

      if (!res || !res.ok) {
        errorMsg.textContent = json.error ?? 'Sign in failed';
        errorMsg.classList.remove('hidden');
        button.disabled = false;
        button.textContent = label;
      } else {
        window.location.href = json.next ?? '/dashboard';
      }
    });
  });
</script>
