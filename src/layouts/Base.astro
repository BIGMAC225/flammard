---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noIndex?: boolean;
}

const appName = import.meta.env.PUBLIC_APP_NAME || 'Flammard';
const { title, description, noIndex = false } = Astro.props;
const pageTitle = title ? `${title} — ${appName}` : appName;
const metaDesc = description ?? 'Meeting records your organization can stand behind.';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={metaDesc} />
  <meta name="theme-color" content="#f8f6f1" />
  {noIndex && <meta name="robots" content="noindex,nofollow" />}
  <title>{pageTitle}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300..700;1,9..40,400&family=Fraunces:opsz,wght@9..144,500..700&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <slot />
</body>
</html>
